{
  "description": "Wingg: forwards session events to the Wingg app. Does nothing when the app is not installed.",
  "hooks": {
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 86400 }] }],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "PermissionDenied": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wingg-hook-shim\"", "timeout": 10 }] }]
  }
}
